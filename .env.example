# ───────────────────────────────────────────────────────────────
# ערכים אישיים / סודות — מוגדרים בתוך n8n כ-Credentials או בפרמטרים
# של ה-nodes. הקובץ הזה הוא תבנית בלבד: אל תכניס ערכים אמיתיים לגיט.
# ───────────────────────────────────────────────────────────────

# מפתח API-Football — נשמר כ-Header Auth credential ב-n8n.
# שם הכותרת: x-apisports-key   |   הערך: המפתח שלך
API_FOOTBALL_KEY=your-api-football-key

# Telegram bot token — נשמר כ-Telegram API credential ב-n8n (מ-@BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ה-Chat ID האישי שאליו תישלח ההתראה (מ-@userinfobot)
# מוגדר בפרמטר chatId של נוד "Send a text message"
TELEGRAM_CHAT_ID=your-telegram-chat-id

# כתובת המייל לקבלת ההתראות
# מוגדרת בפרמטר sendTo של נוד "Send a message"
ALERT_EMAIL=your-email@example.com
